# Server-side only. Unlike the static site, these never reach the browser:
# every Supabase call happens in a Server Component or a Route Handler.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# The Meta Pixel. Without it Meta can only optimise toward clicks, because
# clicks are all it can see. Leave it empty and nothing is injected at all.
NEXT_PUBLIC_PIXEL_ID=
