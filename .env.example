# ---------------------------------------------------------------------------
# NOT NEEDED for the plain HTML site. The static build is configured in
# js/config.js, because a static page has no server to read env vars.
#
# These variables are for the OPTIONAL proxy upgrade described in README.md
# ("If you want a real secret"): a Next.js API route on Vercel, or a
# Cloudflare Worker, that keeps the token server-side.
# ---------------------------------------------------------------------------

# The Apps Script web app URL, ending in /exec. Server-side only.
TTS_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# The shared secret, same value as API_TOKEN in Apps Script Script Properties.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
TTS_API_TOKEN=replace-with-a-long-random-string

# Meta Pixel ID. This one is meant to be public.
NEXT_PUBLIC_PIXEL_ID=

# Never put the Sheet ID here or anywhere the browser can reach.
